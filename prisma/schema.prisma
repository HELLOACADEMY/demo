generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  super_admin
  admin_cabang
  guru
  staff_keuangan
  wali_murid
  siswa
}

enum BranchStatus {
  Active
  Inactive
}

enum UserStatus {
  Active
  Inactive
}

enum StudentStatus {
  Aktif
  Mutasi
  Alumni
  Non_Aktif
}

enum Gender {
  L
  P
}

enum PPDBStatus {
  Pending
  Interview
  Approved
  Rejected
}

enum DownpaymentStatus {
  Unpaid
  Paid
}

enum AttendanceEntityType {
  Siswa
  Guru
  Staff
}

enum AttendanceScanType {
  Jam_Masuk
  Jam_Pulang
}

enum AttendanceStatus {
  Hadir
  Izin
  Sakit
  Alpha
  Terlambat
}

enum FeeType {
  SPP
  Uang_Pangkal
  Buku
  Ujian
}

enum InvoiceStatus {
  Lunas
  Belum_Bayar
  Jatuh_Tempo
}

enum ExamStatus {
  Draft
  Published
  Completed
}

enum LeadStage {
  Lead_Baru
  Follow_Up
  Placement_Test
  Diterima
  Batal
}

model Branch {
  id               String            @id @default(cuid())
  name             String
  code             String            @unique
  address          String            @db.Text
  phone            String
  email            String
  pic              String
  status           BranchStatus      @default(Active)
  totalStudents    Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  users            User[]
  students         Student[]
  teachers         Teacher[]
  ppdbApplications PPDBApplication[]
  classRooms       ClassRoom[]
  attendanceRecords AttendanceRecord[]
  invoices         Invoice[]
  crmLeads         CRMLead[]
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  role      Role
  branchId  String
  avatar    String     @default("👤")
  status    UserStatus @default(Active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]
}

model Parent {
  id         String    @id @default(cuid())
  name       String
  phone      String
  email      String?
  occupation String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  students   Student[]
}

model Student {
  id        String        @id @default(cuid())
  nisn      String        @unique
  name      String
  gender    Gender
  grade     String
  branchId  String
  parentId  String
  status    StudentStatus @default(Aktif)
  qrCode    String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parent    Parent        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
}

model Teacher {
  id                     String      @id @default(cuid())
  nip                    String      @unique
  name                   String
  subject                String
  branchId               String
  hourlyRate             Decimal     @db.Decimal(12, 2)
  teachingHoursThisMonth Int         @default(0)
  phone                  String
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  branch                 Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classRooms             ClassRoom[]
}

model PPDBApplication {
  id                String            @id @default(cuid())
  regNumber         String            @unique
  applicantName     String
  targetBranchId    String
  grade             String
  parentPhone       String
  status            PPDBStatus        @default(Pending)
  testScore         Int?
  downpaymentStatus DownpaymentStatus @default(Unpaid)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  targetBranch      Branch            @relation(fields: [targetBranchId], references: [id], onDelete: Cascade)
}

model ClassRoom {
  id                String   @id @default(cuid())
  name              String
  branchId          String
  grade             String
  homeroomTeacherId String
  capacity          Int      @default(30)
  enrolled          Int      @default(0)
  roomNumber        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  homeroomTeacher   Teacher  @relation(fields: [homeroomTeacherId], references: [id], onDelete: Cascade)
  exams             Exam[]
}

model AttendanceRecord {
  id           String               @id @default(cuid())
  date         String
  entityType   AttendanceEntityType
  entityName   String
  branchId     String
  status       AttendanceStatus
  time         String
  scanType     AttendanceScanType   @default(Jam_Masuk)
  checkInTime  String?
  checkOutTime String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  studentName   String
  studentId     String?
  branchId      String
  feeType       FeeType
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       String
  status        InvoiceStatus @default(Belum_Bayar)
  paymentMethod String?
  paidAt        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student       Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

model Exam {
  id               String     @id @default(cuid())
  title            String
  subject          String
  classId          String
  durationMinutes  Int
  totalQuestions   Int
  date             String
  status           ExamStatus @default(Draft)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  classRoom        ClassRoom  @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp String
  userName  String
  userId    String?
  userRole  Role
  action    String
  module    String
  details   String   @db.Text
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CRMLead {
  id        String    @id @default(cuid())
  name      String
  phone     String
  source    String
  stage     LeadStage @default(Lead_Baru)
  branchId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
}
